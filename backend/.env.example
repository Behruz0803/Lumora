# PriceRadar backend configuration
# Copy to backend/.env and adjust. Never commit real secrets.

# --- Security -------------------------------------------------------------
# Generate a strong value, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database -------------------------------------------------------------
# Development default (SQLite file created automatically):
# DATABASE_URL=sqlite:///./priceradar.db
# Production / Docker (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://priceradar:priceradar@localhost:5432/priceradar
DATABASE_URL=sqlite:///./priceradar.db

# Seed the fictional demo dataset on first start (true/false)
SEED_DEMO_DATA=true

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Regex for hosted preview domains (Arena / E2B). Leave empty to disable.
CORS_ORIGIN_REGEX=https://[a-zA-Z0-9-]+\.e2b\.app

ENVIRONMENT=development
