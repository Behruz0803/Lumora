# ---------------------------------------------------------------------------
# Root .env — only used by docker-compose.yml
# Local development uses backend/.env and frontend/.env instead.
# ---------------------------------------------------------------------------

# Database credentials for the PostgreSQL container
POSTGRES_USER=priceradar
POSTGRES_PASSWORD=priceradar
POSTGRES_DB=priceradar

# Backend secret — replace with a long random string
SECRET_KEY=change-me-to-a-long-random-string
