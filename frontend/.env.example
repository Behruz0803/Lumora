# Optional frontend configuration.
# By default the app calls /api on its own origin, which the Vite dev server
# proxies to the FastAPI backend (see vite.config.ts). Leave empty for local dev.
#
# If you serve the frontend from a different host than the API, set the API origin:
# VITE_API_URL=http://localhost:8000

# Where the Vite dev-server proxy forwards /api requests
# VITE_API_PROXY=http://127.0.0.1:8000
